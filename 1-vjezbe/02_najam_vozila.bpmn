  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="2. Proces najma vozila" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="2. Proces najma vozila" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Klijent">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
