        <bpmn:flowNodeRef>ei</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Administrator">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2" name="Fleet Management">
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Potreban najam vozila">
      <bpmn:outgoing>Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a" name="Ispuniti obrazac i poslati zahtjev">
      <bpmn:incoming>Flow0</bpmn:incoming>
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b" name="Pregledati zahtjev i provjeriti podatke">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g" name="Podaci ispravni?">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="r" name="Odbiti zahtjev">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="er" name="Zahtjev odbijen">
      <bpmn:incoming>Flow4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="c" name="Proslijediti zahtjev voznom parku">
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="d" name="Provjeriti dostupnost vozila">
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="h" name="Vozilo dostupno?">
      <bpmn:incoming>Flow7</bpmn:incoming>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
      <bpmn:outgoing>Flow18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="e" name="Ponuditi zamjensko vozilo">
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="f" name="Pregledati zamjensku ponudu">
      <bpmn:incoming>Flow9</bpmn:incoming>
      <bpmn:outgoing>Flow10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i" name="Ponuda prihvaćena?">
      <bpmn:incoming>Flow10</bpmn:incoming>
      <bpmn:outgoing>Flow11</bpmn:outgoing>
      <bpmn:outgoing>Flow12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ei" name="Najam otkazan">
      <bpmn:incoming>Flow11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="merge" name="">
      <bpmn:incoming>Flow12</bpmn:incoming>
      <bpmn:incoming>Flow18</bpmn:incoming>
      <bpmn:outgoing>Flow13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="j" name="Obavijestiti administratora o vozilu">
      <bpmn:incoming>Flow13</bpmn:incoming>
      <bpmn:outgoing>Flow14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="k" name="Finalizirati rezervaciju i poslati predračun">
      <bpmn:incoming>Flow14</bpmn:incoming>
      <bpmn:outgoing>Flow15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p" name="Izvršiti uplatu predračuna">
      <bpmn:incoming>Flow15</bpmn:incoming>
      <bpmn:outgoing>Flow16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="q" name="Evidentirati uplatu i potvrditi službeni najam">
      <bpmn:incoming>Flow16</bpmn:incoming>
      <bpmn:outgoing>Flow17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="eq" name="Najam potvrđen">
      <bpmn:incoming>Flow17</bpmn:incoming>
    </bpmn:endEvent>
