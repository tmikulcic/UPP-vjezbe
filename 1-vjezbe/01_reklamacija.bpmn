<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01_reklamacija" targetNamespace="https://upp.local/rjesenja" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="1. Proces obrade reklamacije" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="1. Proces obrade reklamacije" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Prodavač">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>el</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Servisni tim">
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ek</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Kupac podnio reklamaciju">
      <bpmn:outgoing>Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a" name="Zaprimiti reklamaciju">
      <bpmn:incoming>Flow0</bpmn:incoming>
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b" name="Provjeriti priloženi račun">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g" name="Račun priložen?">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="r" name="Odbiti reklamaciju">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="er" name="Reklamacija odbijena">
      <bpmn:incoming>Flow4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="c" name="Procijeniti opravdanost (u roku 30 dana od kupnje)">
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="h" name="Reklamacija opravdana?">
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
      <bpmn:outgoing>Flow16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="d" name="Obavijestiti kupca o odbijanju">
      <bpmn:incoming>Flow16</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ed" name="Postupak zatvoren">
      <bpmn:incoming>Flow7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="e" name="Proslijediti proizvod na servis">
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="f" name="Procijeniti mogućnost popravka">
      <bpmn:incoming>Flow9</bpmn:incoming>
      <bpmn:outgoing>Flow10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i" name="Popravak moguć?">
      <bpmn:incoming>Flow10</bpmn:incoming>
      <bpmn:outgoing>Flow11</bpmn:outgoing>
      <bpmn:outgoing>Flow14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="j" name="Popraviti proizvod">
      <bpmn:incoming>Flow11</bpmn:incoming>
      <bpmn:outgoing>Flow12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="k" name="Vratiti ispravan proizvod kupcu">
      <bpmn:incoming>Flow12</bpmn:incoming>
      <bpmn:outgoing>Flow13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ek" name="Proizvod vraćen">
      <bpmn:incoming>Flow13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="l" name="Izdati novi proizvod kupcu">
      <bpmn:incoming>Flow14</bpmn:incoming>
      <bpmn:outgoing>Flow15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="el" name="Proizvod zamijenjen">
      <bpmn:incoming>Flow15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow0" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="Flow1" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="b" targetRef="g" />
    <bpmn:sequenceFlow id="Flow3" name="Ne" sourceRef="g" targetRef="r" />
    <bpmn:sequenceFlow id="Flow5" name="Da" sourceRef="g" targetRef="c" />
    <bpmn:sequenceFlow id="Flow4" sourceRef="r" targetRef="er" />
    <bpmn:sequenceFlow id="Flow6" sourceRef="c" targetRef="h" />
    <bpmn:sequenceFlow id="Flow8" name="Da" sourceRef="h" targetRef="e" />
    <bpmn:sequenceFlow id="Flow16" name="Ne" sourceRef="h" targetRef="d" />
    <bpmn:sequenceFlow id="Flow7" sourceRef="d" targetRef="ed" />
    <bpmn:sequenceFlow id="Flow9" sourceRef="e" targetRef="f" />
    <bpmn:sequenceFlow id="Flow10" sourceRef="f" targetRef="i" />
    <bpmn:sequenceFlow id="Flow11" name="Da" sourceRef="i" targetRef="j" />
    <bpmn:sequenceFlow id="Flow14" name="Ne" sourceRef="i" targetRef="l" />
    <bpmn:sequenceFlow id="Flow12" sourceRef="j" targetRef="k" />
    <bpmn:sequenceFlow id="Flow13" sourceRef="k" targetRef="ek" />
    <bpmn:sequenceFlow id="Flow15" sourceRef="l" targetRef="el" />
  </bpmn:process>
