  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="3. Proces automatizirane korisničke podrške" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="3. Proces automatizirane korisničke podrške" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Klijent">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
