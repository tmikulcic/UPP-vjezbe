  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="5. Proces doniranja hrane" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="5. Proces doniranja hrane" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane0" name="Restoran">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Humanitarna organizacija">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2" name="Volonteri">
        <bpmn:flowNodeRef>k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane3" name="Prihvatilište">
        <bpmn:flowNodeRef>p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>er</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>et</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Postoji višak hrane">
      <bpmn:outgoing>Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="a" name="Označiti višak u IT sustavu">
      <bpmn:incoming>Flow0</bpmn:incoming>
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b" name="Zaprimiti obavijest">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c" name="Provjeriti dostupnost volontera">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g" name="Volonteri dostupni?">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
      <bpmn:outgoing>Flow20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="h" name="Način traženja pomoći?">
      <bpmn:incoming>Flow4</bpmn:incoming>
      <bpmn:incoming>Flow21</bpmn:incoming>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="d" name="Odgoditi preuzimanje i provesti javni poziv">
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="e" name="Zatražiti pomoć partnerskih organizacija">
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="merge" name="">
      <bpmn:incoming>Flow7</bpmn:incoming>
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="f" name="Provjeriti dostupnost bilo koje pomoći">
      <bpmn:incoming>Flow9</bpmn:incoming>
      <bpmn:outgoing>Flow10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="i" name="Pomoć dostupna?">
      <bpmn:incoming>Flow10</bpmn:incoming>
      <bpmn:outgoing>Flow11</bpmn:outgoing>
      <bpmn:outgoing>Flow21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="j" name="Koordinirati preuzimanje s restoranom">
      <bpmn:incoming>Flow11</bpmn:incoming>
      <bpmn:incoming>Flow20</bpmn:incoming>
      <bpmn:outgoing>Flow12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="k" name="Preuzeti hranu">
      <bpmn:incoming>Flow12</bpmn:incoming>
      <bpmn:outgoing>Flow13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="l" name="Dostaviti hranu u prihvatilište">
      <bpmn:incoming>Flow13</bpmn:incoming>
      <bpmn:outgoing>Flow14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p" name="Pregledati kvalitetu hrane">
      <bpmn:incoming>Flow14</bpmn:incoming>
      <bpmn:outgoing>Flow15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="q" name="Većina hrane ne zadovoljava?">
      <bpmn:incoming>Flow15</bpmn:incoming>
      <bpmn:outgoing>Flow16</bpmn:outgoing>
      <bpmn:outgoing>Flow18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="r" name="Sigurno zbrinuti hranu">
      <bpmn:incoming>Flow16</bpmn:incoming>
      <bpmn:outgoing>Flow17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="er" name="Hrana zbrinuta">
      <bpmn:incoming>Flow17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t" name="Sortirati i distribuirati prihvatljivu hranu">
      <bpmn:incoming>Flow18</bpmn:incoming>
      <bpmn:outgoing>Flow19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="et" name="Hrana podijeljena korisnicima">
      <bpmn:incoming>Flow19</bpmn:incoming>
    </bpmn:endEvent>
